FROM docker.io/library/node:26.5-trixie

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    jq \
    gh \
    glab \
    podman \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code

# Bake default configs (skills, hooks, settings) into the image
# Structure mirrors ~/.claude/ -- entrypoint symlinks/merges into persistent home
COPY common_dotfiles/agent-skills /usr/local/share/config/claude-code/skills
COPY containers/claude-code/configs/settings.json /usr/local/share/config/claude-code/settings.json
COPY containers/claude-code/configs/hooks /usr/local/share/config/claude-code/hooks
COPY common_dotfiles/agent-settings/SOUL.md /usr/local/share/config/claude-code/hooks/SOUL.md
COPY containers/claude-code/configs/plugin-setup.sh /usr/local/bin/claude-plugin-setup.sh
RUN chmod +x /usr/local/bin/claude-plugin-setup.sh

ENV AGENT_CONFIG_DEFAULTS=/usr/local/share/config/claude-code \
    AGENT_TARGET_DIR=/root/.claude \
    AGENT_SETTINGS_NAME=settings.json \
    AGENT_SETUP_HOOK=/usr/local/bin/claude-plugin-setup.sh

# Entrypoint: symlinks baked-in defaults, merges settings, installs plugins, then exec's CMD
COPY scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /uvx /bin
ENV PATH="/root/.local/bin:${PATH}"
RUN uv tool install graphifyy && \
    graphify install && \
    mv /root/.claude/skills/graphify /usr/local/share/config/claude-code/skills/graphify

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude"]